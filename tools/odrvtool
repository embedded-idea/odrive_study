#!/usr/bin/env bash
# OdrvTool 启动器
#   ./tools/odrvtool status
#   ./tools/odrvtool vel 0.5
#   ./tools/odrvtool gui
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${ODRV_PYTHON:-$HOME/.odrive-venv/bin/python}"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"

exec "$PY" -m OdrvTool "$@"
