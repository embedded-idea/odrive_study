CM_ SG_ 57 LinearCount "raw encoder count";

BO_ 58 SET_POS_GAIN_Axis1: 8 HOST
 SG_ PosGain : 0|32@1+ (1,0) [0|0] "count/s/count" ODrive
CM_ BO_ 58 "Position loop gain.";
CM_ SG_ 58 PosGain "controller.config.pos_gain IEEE-754 float32, little-endian (decoded natively via SIG_VALTYPE_).";
SIG_VALTYPE_ 58 PosGain : 1;

BO_ 59 SET_VEL_GAINS_Axis1: 8 HOST
 SG_ VelGain : 0|32@1+ (1,0) [0|0] "" ODrive
 SG_ VelIntegratorGain : 32|32@1+ (1,0) [0|0] "" ODrive
CM_ BO_ 59 "Velocity loop gains (proportional + integrator).";
CM_ SG_ 59 VelGain "controller.config.vel_gain IEEE-754 float32, little-endian (decoded natively via SIG_VALTYPE_).";
CM_ SG_ 59 VelIntegratorGain "controller.config.vel_integrator_gain IEEE-754 float32, little-endian (decoded natively via SIG_VALTYPE_).";
SIG_VALTYPE_ 59 VelGain : 1;
SIG_VALTYPE_ 59 VelIntegratorGain : 1;

BO_ 60 GET_ADC_VOLTAGE_Axis1: 8 HOST
 SG_ Gpio : 0|8@1+ (1,0) [0|0] "" ODrive
CM_ BO_ 60 "Request: GPIO number in byte 0. ODrive replies on the SAME ID with float32 voltage in bytes 0-3 (see CANSimple::get_adc_voltage_callback); DBC cannot express both directions on one ID.";
CM_ SG_ 60 Gpio "GPIO number to sample (request frame)";

BO_ 61 GET_CONTROLLER_ERROR_Axis1: 8 ODrive
 SG_ ControllerError : 0|32@1+ (1,0) [0|0] "" HOST
CM_ BO_ 61 "Response: controller error. Trigger: RTR or empty frame with same ID.";
CM_ SG_ 61 ControllerError "controller.error_ bitfield";

